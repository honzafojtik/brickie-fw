#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {

    behaviors {
      esc_tilde: esc_tilde {
          compatible = "zmk,behavior-mod-morph";
          #binding-cells = <0>;
          bindings = <&kp ESC>, <&kp TILDE>;
          mods = <(MOD_LSFT | MOD_RSFT)>;
      };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer: base {
            display-name = "base";

            bindings = <
                &gresc     &kp N1     &kp N2     &kp N3     &kp N4     &kp N5        &kp N6     &kp N7     &kp N8     &kp N9     &kp N0     &kp DEL
                &kp TAB    &kp Q      &kp W      &kp E      &kp R      &kp T         &kp Y      &kp U      &kp I      &kp O      &kp P      &kp BSLH
                &kp LGUI   &kp A      &kp S      &kp D      &kp F      &kp G         &kp H      &kp J      &kp K      &kp L      &kp SEMI   &kp SQT
                &kp LSHFT  &kp Z      &kp X      &kp C      &kp V      &kp B         &kp N      &kp M      &kp COMMA  &kp DOT    &kp FSLH   &kp GRAVE
                &kp LCTRL  &kp LALT   &kp HOME   &kp END    &mo 1      &kp SPACE     &kp BSPC   &kp RET    &kp MINUS  &kp EQUAL  &mo 1      &kp RCTRL
            >;
        };

        lower {
            display-name = "lower";

            bindings = <
                &kp F1     &kp F2     &kp F3     &kp F4     &kp F5     &kp F6        &kp F7     &kp F8          &kp F9     &kp F10    &kp F11    &kp F12
                &trans     &trans     &kp UP     &trans     &trans     &trans        &trans     &trans          &trans     &trans     &trans     &trans
                &kp ESC    &kp LEFT   &kp DOWN   &kp RIGHT  &trans     &trans        &trans     &trans          &trans     &kp LBKT   &kp RBKT   &trans
                &trans     &trans     &trans     &trans     &trans     &trans        &trans     &trans          &trans     &trans     &trans     &trans
                &trans     &trans     &trans     &trans     &trans     &trans        &trans     &studio_unlock  &trans     &trans     &trans     &trans
            >;
        };
    };
};

